# Copy this file to .env and fill in your own values. Never commit .env.
# Private app access token (HubSpot: Settings > Integrations > Private Apps). Scopes needed:
# automation, content, crm.objects.contacts.read, crm.objects.contacts.write,
# crm.schemas.contacts.read, crm.schemas.contacts.write, settings.users.read
HUBSPOT_TOKEN=pat-xxx-00000000-0000-0000-0000-000000000000
# Optional, not used by the scripts
HUBSPOT_CLIENT_SECRET=
# Your HubSpot portal (hub) ID
HUBSPOT_PORTAL_ID=00000000
